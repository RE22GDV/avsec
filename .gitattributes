# Text files keep LF in the repository; git checks them out with the platform's
# own endings.  The .bat launcher must be CRLF or cmd.exe misparses it.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch these.
*.png binary
*.jpg binary
*.pdf binary
*.svg text eol=lf
